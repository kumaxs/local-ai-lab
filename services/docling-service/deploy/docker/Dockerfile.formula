FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/huggingface \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_DOWNLOAD_TIMEOUT=600 \
    NO_ALBUMENTATIONS_UPDATE=1 \
    PADDLE_PDX_MODEL_SOURCE=BOS \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_CACHE_HOME=/models/paddlex \
    DOCLING_FORMULA_MODEL=wanderkid/unimernet_small \
    DOCLING_FORMULA_FALLBACK_MODEL=PP-FormulaNet-L \
    DOCLING_FORMULA_MODEL_ROOT=/models/unimernet \
    DOCLING_FORMULA_BATCH_SIZE=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
       libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 docling \
    && useradd --uid 10001 --gid 10001 --create-home docling

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN python -m pip install --no-cache-dir --index-url ${PYTORCH_INDEX_URL} \
      torch==2.12.0 torchvision==0.27.0

COPY services/docling-service/deploy/docker/formula-runtime.txt /tmp/formula-runtime.txt
RUN python -m pip install --no-cache-dir -r /tmp/formula-runtime.txt \
    && python -m pip check

COPY services/docling-service/docling_service/formula_api.py /opt/formula-service/formula_api.py

RUN mkdir -p /models/unimernet /models/paddlex \
    && chown -R docling:docling /models /opt/formula-service

USER 10001:10001
WORKDIR /opt/formula-service
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=1200s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/healthz', timeout=3)"

CMD ["uvicorn", "formula_api:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
