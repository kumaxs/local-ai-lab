{
  "$schema": "../schemas/lail-coverage-policy.schema.json",
  "schema_name": "lail.coverage-policy",
  "schema_version": "0.1.0",
  "policy_id": "policy-strict-v1",
  "delivery_mode": "strict_machine",
  "required_inventory_evidence_classes": [
    "text",
    "table",
    "formula",
    "figure",
    "algorithm",
    "code"
  ],
  "required_check_class_combination": "ordered_union_role_then_payload",
  "required_check_class_rules": [
    {"selector_type": "role", "selector": "title", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "heading", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "paragraph", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "list", "required_check_classes": ["text", "reading_order"]},
    {"selector_type": "role", "selector": "list_item", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "table", "required_check_classes": ["table"]},
    {"selector_type": "role", "selector": "figure", "required_check_classes": ["figure"]},
    {"selector_type": "role", "selector": "chart", "required_check_classes": ["figure"]},
    {"selector_type": "role", "selector": "caption", "required_check_classes": ["caption"]},
    {"selector_type": "role", "selector": "display_formula", "required_check_classes": ["formula"]},
    {"selector_type": "role", "selector": "inline_formula", "required_check_classes": ["formula"]},
    {"selector_type": "role", "selector": "algorithm", "required_check_classes": ["algorithm"]},
    {"selector_type": "role", "selector": "algorithm_step", "required_check_classes": ["algorithm"]},
    {"selector_type": "role", "selector": "code_block", "required_check_classes": ["code"]},
    {"selector_type": "role", "selector": "footnote", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "header", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "footer", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "page_number", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "reference_entry", "required_check_classes": ["text"]},
    {"selector_type": "role", "selector": "decorative", "required_check_classes": ["layout"]},
    {"selector_type": "role", "selector": "unknown", "required_check_classes": ["layout"]},
    {"selector_type": "payload_kind", "selector": "text", "required_check_classes": ["text"]},
    {"selector_type": "payload_kind", "selector": "formula", "required_check_classes": ["formula"]},
    {"selector_type": "payload_kind", "selector": "table", "required_check_classes": ["table"]},
    {"selector_type": "payload_kind", "selector": "figure", "required_check_classes": ["figure"]},
    {"selector_type": "payload_kind", "selector": "algorithm", "required_check_classes": ["algorithm"]},
    {"selector_type": "payload_kind", "selector": "code", "required_check_classes": ["code"]}
  ],
  "verified_semantic_forbidden_roles": [
    "decorative",
    "unknown"
  ],
  "criticality_rules": [
    {"role": "title", "floor": "material"},
    {"role": "heading", "floor": "material"},
    {"role": "paragraph", "floor": "normal"},
    {"role": "list", "floor": "normal"},
    {"role": "list_item", "floor": "normal"},
    {"role": "table", "floor": "critical"},
    {"role": "figure", "floor": "critical"},
    {"role": "chart", "floor": "critical"},
    {"role": "caption", "floor": "normal"},
    {"role": "display_formula", "floor": "critical"},
    {"role": "inline_formula", "floor": "critical"},
    {"role": "algorithm", "floor": "critical"},
    {"role": "algorithm_step", "floor": "critical"},
    {"role": "code_block", "floor": "critical"},
    {"role": "footnote", "floor": "normal"},
    {"role": "header", "floor": "decorative"},
    {"role": "footer", "floor": "decorative"},
    {"role": "page_number", "floor": "decorative"},
    {"role": "reference_entry", "floor": "normal"},
    {"role": "decorative", "floor": "decorative"},
    {"role": "unknown", "floor": "critical"}
  ],
  "check_evidence_rules": [
    {"check_class": "text", "allowed_evidence_kinds": ["ocr", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "table", "allowed_evidence_kinds": ["table", "visual", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "formula", "allowed_evidence_kinds": ["formula", "visual", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "figure", "allowed_evidence_kinds": ["visual", "layout", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "algorithm", "allowed_evidence_kinds": ["algorithm", "visual", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "code", "allowed_evidence_kinds": ["code", "ocr", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "caption", "allowed_evidence_kinds": ["caption", "ocr", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "reading_order", "allowed_evidence_kinds": ["reading_order", "layout", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region", "relation"]},
    {"check_class": "layout", "allowed_evidence_kinds": ["layout", "visual", "human_annotation", "ground_truth"], "allowed_coverage_roles": ["region_observation"], "allowed_subject_scopes": ["region"]},
    {"check_class": "provenance", "allowed_evidence_kinds": ["provenance", "ground_truth"], "allowed_coverage_roles": ["region_observation", "page_support"], "allowed_subject_scopes": ["region", "page", "document"]},
    {"check_class": "security", "allowed_evidence_kinds": ["provenance", "ground_truth"], "allowed_coverage_roles": ["page_support"], "allowed_subject_scopes": ["page", "document"]},
    {"check_class": "source_inventory", "allowed_evidence_kinds": ["ocr", "visual", "layout", "vector", "table", "formula", "code", "reading_order", "caption", "algorithm", "human_annotation", "ground_truth", "provenance"], "allowed_coverage_roles": ["region_observation", "page_support"], "allowed_subject_scopes": ["page"]}
  ]
}
