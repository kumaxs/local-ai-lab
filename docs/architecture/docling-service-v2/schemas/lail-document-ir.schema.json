{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-lab:schema:lail-document-ir:v0.1.0",
  "title": "LAIL Document IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "document_id",
    "source",
    "run",
    "pages",
    "assets",
    "evidence",
    "source_inventory",
    "candidates",
    "regions",
    "relations",
    "validation_reports",
    "delivery"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "lail.document-ir"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc-[0-9a-fA-F]{64}$",
      "description": "Content-derived document identity.",
      "$comment": "Normative semantic invariant: document_id MUST equal the literal prefix 'doc-' followed by source.sha256."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      },
      "uniqueItems": true,
      "$comment": "page_number is 1-based. Page and region/ candidate bboxes need downstream cross-check for containment and coordinate consistency."
    },
    "assets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/asset"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "uniqueItems": true
    },
    "source_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_inventory_entry"
      },
      "uniqueItems": true,
      "$comment": "Semantic validation requires exactly one entry per page and exact equality between required_evidence_classes and the digest-pinned coverage policy."
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "uniqueItems": true,
      "$comment": "Candidate references are intentionally immutable and source-bound."
    },
    "regions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/region"
      },
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "uniqueItems": true
    },
    "validation_reports": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/validation_report"
      },
      "uniqueItems": true
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "mode": {
                "const": "strict_machine"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["delivery"]
      },
      "then": {
        "properties": {
          "validation_reports": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "strict_machine_eligible": {
                "const": true
              }
            },
            "required": ["strict_machine_eligible"]
          }
        },
        "required": ["delivery"]
      },
      "then": {
        "properties": {
          "delivery": {
            "required": ["state", "counts"],
            "properties": {
              "state": {
                "const": "succeeded"
              },
              "renderable": {
                "const": true
              },
              "blocking": {
                "properties": {
                  "reason_codes": {"maxItems": 0},
                  "validation_report_refs": {"maxItems": 0}
                }
              },
              "counts": {
                "required": ["critical_non_verified"],
                "properties": {
                  "critical_non_verified": {
                    "const": 0
                  }
                }
              }
            }
          },
          "regions": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "required": ["criticality", "resolution"],
                "properties": {
                  "criticality": {
                    "const": "critical"
                  },
                  "resolution": {
                    "type": "object",
                    "required": ["final_state"],
                    "properties": {
                      "final_state": {
                        "enum": ["unresolved", "visual_only"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "mode": {
                "const": "strict_machine"
              },
              "strict_machine_eligible": {
                "const": false
              }
            },
            "required": ["mode", "strict_machine_eligible"]
          }
        },
        "required": ["delivery"]
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "state": {
                "const": "failed"
              },
              "renderable": {
                "const": false
              },
              "blocking": {
                "properties": {
                  "reason_codes": {
                    "minItems": 1
                  },
                  "validation_report_refs": {
                    "minItems": 1
                  }
                },
                "required": ["reason_codes", "validation_report_refs"]
              }
            },
            "required": ["state", "renderable", "blocking"]
          }
        }
      }
    }
  ],
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        }
      },
      "$comment": "TOPLEFT coordinate system. Coordinate comparison constraints (left < right, top < bottom, right/top bounds against page dims) are enforced outside schema."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_id",
        "sha256",
        "media_type",
        "size_bytes",
        "page_count"
      ],
      "properties": {
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "$comment": "Opaque safe identifier for source snapshot retrieval."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "media_type": {
          "type": "string",
          "const": "application/pdf"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "policy_id",
        "policy_sha256",
        "trust_registry_sha256",
        "started_at",
        "producer_runs"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "trust_registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/producer_run"
          },
          "uniqueItems": true
        }
      }
    },
    "producer_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_run_id",
        "adapter_id",
        "adapter_version",
        "engine_id",
        "engine_version",
        "model_config_sha256",
        "correlation_group",
        "source_snapshot_id",
        "source_sha256",
        "status"
      ],
      "properties": {
        "producer_run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pr-[0-9a-fA-F-]{8,}$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "engine_id": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "model_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "correlation_group": {
          "type": "string",
          "minLength": 1,
          "$comment": "Trust-correlation domain used by the semantic validator when checking producer/validator independence."
        },
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "skipped", "partial"]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "width_points and height_points describe the normalized displayed orientation. Bboxes use that top-left frame after applying the recorded source rotation.",
      "required": [
        "page_id",
        "page_number",
        "width_points",
        "height_points",
        "rotation",
        "region_ids"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^pg-[0-9a-fA-F]{8,}$"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "width_points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "integer",
          "enum": [0, 90, 180, 270]
        },
        "region_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^reg-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "sha256",
        "source_snapshot_id",
        "source_sha256",
        "evidence_ids",
        "media_type",
        "size_bytes",
        "purpose",
        "width_px",
        "height_px"
      ],
      "$comment": "asset_id MUST equal `asset-sha256-${sha256}`; this is a content-addressed invariant.",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset-sha256-[0-9a-fA-F]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string",
          "enum": ["page_image", "thumbnail", "annotation", "region_crop", "other"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "provider_id",
        "provider_version",
        "provider_implementation_sha256",
        "independence_group",
        "source_snapshot_id",
        "source_sha256",
        "page_id",
        "bbox",
        "kind",
        "coverage_role",
        "observed_at"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^ev-[0-9a-fA-F]{8,}$"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "provider_implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "independence_group": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "page_id": {
          "type": "string",
          "pattern": "^pg-[0-9a-fA-F]{8,}$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ocr",
            "visual",
            "layout",
            "vector",
            "table",
            "formula",
            "code",
            "reading_order",
            "caption",
            "algorithm",
            "human_annotation",
            "ground_truth",
            "provenance"
          ]
        },
        "coverage_role": {
          "type": "string",
          "enum": ["region_observation", "page_support"]
        },
        "observed_role": {
          "$ref": "#/$defs/role"
        },
        "observed_criticality": {
          "type": "string",
          "enum": ["critical", "material", "normal", "decorative"]
        },
        "asset_id": {
          "type": "string",
          "pattern": "^asset-sha256-[0-9a-fA-F]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage_role": {
                "const": "region_observation"
              }
            },
            "required": ["coverage_role"]
          },
          "then": {
            "required": ["observed_role", "observed_criticality"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["observed_role"]},
                {"required": ["observed_criticality"]}
              ]
            }
          }
        }
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "text",
        "table",
        "formula",
        "figure",
        "algorithm",
        "code",
        "caption",
        "reading_order",
        "layout",
        "other"
      ]
    },
    "inventory_class_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_class", "state", "evidence_ids"],
      "properties": {
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "state": {
          "type": "string",
          "enum": ["observed", "absent", "indeterminate"]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "observed"}},
            "required": ["state"]
          },
          "then": {
            "properties": {"evidence_ids": {"minItems": 1}}
          },
          "else": {
            "properties": {"evidence_ids": {"maxItems": 0}}
          }
        }
      ]
    },
    "source_inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "page_id",
        "source_snapshot_id",
        "source_sha256",
        "policy_sha256",
        "provider_id",
        "provider_version",
        "provider_implementation_sha256",
        "independence_group",
        "page_content_state",
        "required_evidence_classes",
        "class_results",
        "page_support_evidence_ids",
        "observed_at"
      ],
      "properties": {
        "inventory_id": {
          "type": "string",
          "pattern": "^inv-[0-9a-fA-F]{8,}$"
        },
        "page_id": {
          "type": "string",
          "pattern": "^pg-[0-9a-fA-F]{8,}$"
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "provider_implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "independence_group": {"type": "string", "minLength": 1},
        "page_content_state": {
          "type": "string",
          "enum": ["content_present", "blank", "indeterminate"]
        },
        "required_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_class"},
          "uniqueItems": true
        },
        "class_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_class_result"},
          "uniqueItems": true
        },
        "page_support_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"page_content_state": {"const": "content_present"}},
            "required": ["page_content_state"]
          },
          "then": {
            "properties": {
              "class_results": {
                "contains": {
                  "properties": {"state": {"const": "observed"}},
                  "required": ["state"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"page_content_state": {"const": "blank"}},
            "required": ["page_content_state"]
          },
          "then": {
            "properties": {
              "class_results": {
                "items": {
                  "properties": {"state": {"const": "absent"}},
                  "required": ["state"]
                }
              },
              "page_support_evidence_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"page_content_state": {"const": "indeterminate"}},
            "required": ["page_content_state"]
          },
          "then": {
            "properties": {
              "class_results": {
                "items": {
                  "properties": {"state": {"const": "indeterminate"}},
                  "required": ["state"]
                }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "producer_run_id",
        "native_id",
        "page_id",
        "bbox",
        "role",
        "payload",
        "evidence_ids",
        "raw_confidence"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^cand-[0-9a-fA-F]{8,}$"
        },
        "producer_run_id": {
          "type": "string",
          "pattern": "^pr-[0-9a-fA-F-]{8,}$"
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "page_id": {
          "type": "string",
          "pattern": "^pg-[0-9a-fA-F]{8,}$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "payload": {
          "$ref": "#/$defs/typed_payload"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "raw_confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detection",
            "geometry",
            "content",
            "binding"
          ],
          "properties": {
            "detection": {
              "anyOf": [
                {
                  "$ref": "#/$defs/raw_score"
                },
                {
                  "type": "null"
                }
              ]
            },
            "geometry": {
              "anyOf": [
                {
                  "$ref": "#/$defs/raw_score"
                },
                {
                  "type": "null"
                }
              ]
            },
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/raw_score"
                },
                {
                  "type": "null"
                }
              ]
            },
            "binding": {
              "anyOf": [
                {
                  "$ref": "#/$defs/raw_score"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "$comment": "Raw scores only; these are not calibrated probabilities."
        },
        "vendor_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes",
            "media_type"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "raw_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "scale", "unit"],
      "properties": {
        "value": {
          "type": "number"
        },
        "scale": {
          "type": "string",
          "enum": [
            "logit",
            "probability",
            "log-probability",
            "rank",
            "z-score"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "page_id",
        "bbox",
        "role",
        "criticality",
        "candidate_ids",
        "evidence_ids",
        "lineage",
        "resolution"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "pattern": "^reg-[0-9a-fA-F]{8,}$",
          "$comment": "ID derivation MUST be scoped by source SHA-256, schema version, reconciliation policy, and geometry/structural anchors; it MUST NOT depend on candidate text or list order."
        },
        "page_id": {
          "type": "string",
          "pattern": "^pg-[0-9a-fA-F]{8,}$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "criticality": {
          "type": "string",
          "enum": ["critical", "material", "normal", "decorative"]
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^cand-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "properties": {
                  "final_state": {
                    "const": "verified_semantic"
                  }
                },
                "required": ["final_state"]
              }
            },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "$comment": "Relations, identifier uniqueness, reference integrity, candidate overlaps, bbox containment, and non-cyclic lineage are enforced by the mandatory semantic validator."
    },
    "role": {
      "type": "string",
      "enum": [
        "title",
        "heading",
        "paragraph",
        "list",
        "list_item",
        "table",
        "figure",
        "chart",
        "caption",
        "display_formula",
        "inline_formula",
        "algorithm",
        "algorithm_step",
        "code_block",
        "footnote",
        "header",
        "footer",
        "page_number",
        "reference_entry",
        "decorative",
        "unknown"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stability",
        "policy_id",
        "operation",
        "predecessor_ids"
      ],
      "properties": {
        "stability": {
          "type": "string",
          "enum": [
            "policy_stable",
            "run_local"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "original",
            "merge",
            "split",
            "remap"
          ]
        },
        "predecessor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^reg-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"operation": {"const": "original"}},
            "required": ["operation"]
          },
          "then": {
            "properties": {"predecessor_ids": {"maxItems": 0}}
          }
        },
        {
          "if": {
            "properties": {"operation": {"const": "merge"}},
            "required": ["operation"]
          },
          "then": {
            "properties": {"predecessor_ids": {"minItems": 2}}
          }
        },
        {
          "if": {
            "properties": {"operation": {"enum": ["split", "remap"]}},
            "required": ["operation"]
          },
          "then": {
            "properties": {"predecessor_ids": {"minItems": 1, "maxItems": 1}}
          }
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "$ref": "#/$defs/verified_semantic_resolution"
        },
        {
          "$ref": "#/$defs/visual_only_resolution"
        },
        {
          "$ref": "#/$defs/unresolved_resolution"
        }
      ]
    },
    "verified_semantic_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_state",
