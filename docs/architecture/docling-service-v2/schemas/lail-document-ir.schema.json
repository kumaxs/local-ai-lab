          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review_required": {
          "type": "boolean",
          "const": false
        },
        "calibrated_confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calibration_id", "detection", "geometry", "content", "binding"],
          "properties": {
            "calibration_id": {
              "type": "string",
              "minLength": 1
            },
            "detection": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "geometry": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "content": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "binding": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "$comment": "calibrated_confidence is optional and accepts null component scores."
    },
