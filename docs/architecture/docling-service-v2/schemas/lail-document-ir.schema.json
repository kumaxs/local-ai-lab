    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "run_id",
        "source_snapshot_id",
        "policy_sha256",
        "trust_registry_sha256",
        "validator_id",
        "validator_version",
        "implementation_sha256",
        "independence_group",
        "source_sha256",
        "execution_status",
        "created_at",
        "checks"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^vr-[0-9a-fA-F]{8,}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "trust_registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "validator_id": {
          "type": "string",
          "minLength": 1
        },
        "validator_version": {
          "type": "string",
          "minLength": 1
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "independence_group": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "execution_status": {
          "type": "string",
          "enum": ["completed", "partial", "unavailable", "failed"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validation_check"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "enum": ["unavailable", "failed"]
              }
            },
            "required": ["execution_status"]
          },
          "then": {
            "properties": {
              "checks": {
                "items": {
                  "properties": {
                    "result": {
                      "const": "indeterminate"
                    }
                  },
                  "required": ["result"]
                }
              }
            }
          }
        }
      ]
    },
    "validation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "result",
        "severity",
        "category",
        "check_class",
        "target_sha256",
        "subject",
        "evidence_ids",
        "reason_codes"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "indeterminate"]
        },
        "severity": {
          "type": "string",
          "enum": ["p0", "p1", "p2", "p3"]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "check_class": {
          "type": "string",
          "enum": [
            "text",
            "table",
            "formula",
            "figure",
            "algorithm",
            "code",
            "caption",
            "reading_order",
            "layout",
            "provenance",
            "security",
            "source_inventory"
          ]
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "number"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": ["pass", "fail"]
              }
            },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
