        },
        "validation_report_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^vr-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "unresolved_resolution": {
      "type": "object",
