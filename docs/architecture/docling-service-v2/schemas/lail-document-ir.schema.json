            "caption_of",
            "label_of",
            "footnote_of",
            "continuation_of",
            "references",
            "derived_from",
            "inline_in"
          ]
        },
        "source_region_id": {
          "type": "string",
          "pattern": "^reg-[0-9a-fA-F]{8,}$"
        },
        "target_region_id": {
          "type": "string",
          "pattern": "^reg-[0-9a-fA-F]{8,}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
