        },
        "selected_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cand-[0-9a-fA-F]{8,}$"
          },
          "uniqueItems": true
        },
        "review_required": {
          "type": "boolean",
          "const": true
        }
      }
